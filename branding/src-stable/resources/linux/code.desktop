[Desktop Entry]
Name=@@NAME_LONG@@
Comment=AI code editor
Comment[pt]=Editor de código com IA
Comment[pt_BR]=Editor de código com IA
Comment[es]=Editor de código con IA
GenericName=Code Editor
GenericName[pt]=Editor de código
GenericName[pt_BR]=Editor de código
GenericName[es]=Editor de código
GenericName[ar]=محرر نصوص
Exec=@@EXEC@@ %F
Icon=@@ICON@@
Type=Application
StartupNotify=false
StartupWMClass=@@NAME_SHORT@@
Categories=TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;application/x-@@NAME@@-workspace;
Actions=new-empty-window;
Keywords=arara;code;ide;editor;ia;ai;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[pt_BR]=Nova janela vazia
Name[ar]=نافذة فارغة جديدة
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Name[fr]=Nouvelle fenêtre vide
Name[it]=Nuova finestra vuota
Name[ja]=新しい空のウィンドウ
Name[ko]=새 빈 창
Name[ru]=Новое пустое окно
Name[zh_CN]=新建空窗口
Name[zh_TW]=開新空視窗
Exec=@@EXEC@@ --new-window %F
Icon=@@ICON@@
