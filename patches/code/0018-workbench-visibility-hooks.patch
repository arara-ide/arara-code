+	protected override createTitleArea(parent: HTMLElement): HTMLElement | undefined {
+		const area = super.createTitleArea(parent);
+		if (!area) { return area; }
+		const controls = document.createElement('div');
+		controls.className = 'arara-panel-launcher';
+		const button = document.createElement('button');
+		button.textContent = '+';
+		button.setAttribute('aria-label', localize('arara.newTerminal', "New platform terminal"));
+		button.setAttribute('aria-expanded', 'false');
+		button.setAttribute('aria-haspopup', 'menu');
+		controls.append(button);
+		area.insertBefore(controls, area.querySelector('.title-actions'));
+		const update = () => {
+			controls.hidden = !this.contextKeyService.getContextKeyValue('arara.ui.hideAdvanced');
+			if (controls.hidden) { button.setAttribute('aria-expanded', 'false'); }
+		};
+		update();
+		this._register(this.contextKeyService.onDidChangeContext(e => {
+			if (e.affectsSome(new Set(['arara.ui.hideAdvanced']))) { update(); }
+		}));
+		this._register(addDisposableListener(button, 'click', async () => {
+			button.disabled = true;
+			try {
+				const items = await this.commandService.executeCommand<{ id: string; label: string }[]>('arara.terminal.platforms');
+				if (!items?.length || controls.hidden) { return; }
+				button.setAttribute('aria-expanded', 'true');
+				this.contextMenuService.showContextMenu({
+					getAnchor: () => {
+						const position = getDomNodePagePosition(button);
+						return { x: position.left, y: position.top - 5, width: position.width, height: position.height + 10 };
+					},
+					getActions: () => items.map(item => toAction({
+						id: item.id, label: item.label,
+						run: async () => {
+							try { await this.commandService.executeCommand('arara.terminal.openPlatform', item.id); }
+							catch (error) { this.launcherNotificationService.error(error); }
+						}
+					})),
+					onHide: () => { button.setAttribute('aria-expanded', 'false'); button.focus(); },
+					skipTelemetry: true
+				});
+			} catch (error) { this.launcherNotificationService.error(error); }
+			finally { button.disabled = false; }
+		}));
+		return area;
+	}
