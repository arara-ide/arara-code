+/* Inline extension-owned terminal launcher. */
+.monaco-workbench .part.panel .arara-panel-launcher { display: flex; align-items: center; gap: 6px; margin-left: 8px; }
+.monaco-workbench .part.panel .arara-panel-launcher[hidden],
+.monaco-workbench .part.panel .arara-panel-launcher [hidden] { display: none !important; }
+.monaco-workbench .part.panel .arara-panel-launcher button { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0; color: var(--vscode-icon-foreground); background: transparent; border: none; border-radius: 5px; cursor: pointer; font-size: 18px; }
+.monaco-workbench .part.panel .arara-panel-launcher button:hover,
+.monaco-workbench .part.panel .arara-panel-launcher button[aria-expanded="true"] { background: var(--vscode-toolbar-hoverBackground); }
