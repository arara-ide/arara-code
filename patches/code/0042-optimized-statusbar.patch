+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="status.editor.mode"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="status.editor.eol"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="status.editor.encoding"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="status.editor.indentation"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="status.editor.selection"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="esbenp.prettier-vscode.prettier.status"],
+.monaco-workbench .part.statusbar.arara-hide-advanced .statusbar-item[id="esbenp.prettier-vscode"] {
+	display: none !important;
+}
 
