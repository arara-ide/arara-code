Arara Code: hide editor metadata and formatter status in optimized access.

Why a patch: extension APIs cannot hide built-in status bar entries or entries
owned by another extension without changing persisted user visibility choices.
The existing extension-controlled arara.ui.hideAdvanced context gates only
presentation; commands, formatting and stored visibility remain unchanged.
Touches: statusbarPart.ts and media/statusbarpart.css.

--- a/src/vs/workbench/browser/parts/statusbar/statusbarPart.ts
+++ b/src/vs/workbench/browser/parts/statusbar/statusbarPart.ts
@@ -445,6 +445,14 @@
 	protected override createContentArea(parent: HTMLElement): HTMLElement {
 		this.element = parent;
 
+		const updateAdvancedVisibility = () => {
+			parent.classList.toggle('arara-hide-advanced', !!this.contextKeyService.getContextKeyValue('arara.ui.hideAdvanced'));
+		};
+		updateAdvancedVisibility();
+		this._register(this.contextKeyService.onDidChangeContext(event => {
+			if (event.affectsSome(new Set(['arara.ui.hideAdvanced']))) { updateAdvancedVisibility(); }
+		}));
+
 		// Track focus within container
 		const scopedContextKeyService = this._register(this.contextKeyService.createScoped(this.element));
 		StatusBarFocused.bindTo(scopedContextKeyService).set(true);
--- a/src/vs/workbench/browser/parts/statusbar/media/statusbarpart.css
+++ b/src/vs/workbench/browser/parts/statusbar/media/statusbarpart.css
@@ -2,6 +2,16 @@
