+	private auxiliaryActionButton: HTMLButtonElement | undefined;
+
+	protected override updateCompositeBar(updateCompositeBarOption: boolean = false): void {
+		super.updateCompositeBar(updateCompositeBarOption);
+		const container = this.getContainer();
+		const area = container?.querySelector<HTMLElement>('.header-or-footer.has-composite-bar') ?? container?.querySelector<HTMLElement>(':scope > .title');
+		if (!area) { return; }
+		if (!this.auxiliaryActionButton) {
+			const button = this.auxiliaryActionButton = area.ownerDocument.createElement('button');
+			button.className = 'arara-auxiliary-action';
+			button.type = 'button';
+			const update = () => {
+				const command = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxiliaryActionCommand');
+				const label = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxiliaryActionLabel') ?? '';
+				const icon = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxiliaryActionIcon') ?? '';
+				button.hidden = !command;
+				button.title = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxiliaryActionTitle') ?? label;
+				button.setAttribute('aria-label', button.title);
+				button.replaceChildren();
+				if (/^[a-z0-9-]+$/.test(icon)) {
+					const glyph = area.ownerDocument.createElement('span');
+					glyph.className = `codicon codicon-${icon}`;
+					glyph.setAttribute('aria-hidden', 'true');
+					button.append(glyph);
+				}
+				button.append(area.ownerDocument.createTextNode(label));
+				this.layoutCompositeBar();
+			};
+			this._register(this.contextKeyService.onDidChangeContext(e => {
+				if (e.affectsSome(new Set(['arara.ui.auxiliaryActionCommand', 'arara.ui.auxiliaryActionLabel', 'arara.ui.auxiliaryActionTitle', 'arara.ui.auxiliaryActionIcon']))) { update(); }
+			}));
+			this._register(addDisposableListener(button, 'click', async () => {
+				const command = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxiliaryActionCommand');
+				if (!command) { return; }
+				button.disabled = true;
+				try { await this.commandService.executeCommand(command); }
+				catch (error) { this.actionNotificationService.error(error); }
+				finally { button.disabled = false; }
+			}));
+			update();
+		}
+		area.append(this.auxiliaryActionButton);
+		this.layoutCompositeBar();
+	}
