+
+import './media/startupWebview.css';
+import { Disposable } from '../../base/common/lifecycle.js';
+import { IContextKeyService } from '../../platform/contextkey/common/contextkey.js';
+import { IExtensionStorageService } from '../../platform/extensionManagement/common/extensionStorage.js';
+import { IProductService } from '../../platform/product/common/productService.js';
+
+export class StartupWebview extends Disposable {
+	constructor(
+		container: HTMLElement,
+		@IProductService product: IProductService,
+		@IExtensionStorageService extensionStorage: IExtensionStorageService,
+		@IContextKeyService contextKeys: IContextKeyService,
+	) {
+		super();
+		const startup = product.startupWebview;
+		if (startup && extensionStorage.getExtensionState(startup.extensionId, true)?.[startup.completedKey] !== true) {
+			contextKeys.createKey('arara.modal.allowedCommands', ['workbench.action.reloadWindow', 'workbench.action.closeWindow', 'workbench.action.quit']);
+			contextKeys.createKey('arara.modal.viewType', startup.viewType);
+		}
+		const placeholder = document.createElement('div');
+		placeholder.className = 'startup-webview-placeholder';
+		placeholder.setAttribute('role', 'status');
+		placeholder.ariaLabel = product.nameLong;
+		container.appendChild(placeholder);
+		const update = () => {
+			const active = !!contextKeys.getContextKeyValue('arara.modal.viewType');
+			container.classList.toggle('blocking-webview', active);
+			placeholder.hidden = !active;
+		};
+		update();
+		this._register(contextKeys.onDidChangeContext(event => {
+			if (event.affectsSome(new Set(['arara.modal.viewType']))) { update(); }
+		}));
+	}
+}
