+++ b/src/vs/workbench/browser/media/startupWebview.css
@@ -0,0 +1,21 @@
+/* A blocking webview is the only workbench surface, including the first frame. */
+.monaco-workbench.blocking-webview > :not(.monaco-modal-editor-block):not(.quick-input-widget):not(.monaco-dialog-modal-block):not(.startup-webview-placeholder):not(:has(> .blocking-webview-content)) {
+	visibility: hidden !important;
+	pointer-events: none !important;
+}
+.monaco-workbench > .startup-webview-placeholder {
+	position: absolute;
+	inset: 0;
+	z-index: 2540;
+	display: flex;
+	align-items: center;
+	justify-content: center;
+	background: var(--vscode-editor-background);
+	color: var(--vscode-foreground);
+	font-size: 24px;
+}
+.monaco-workbench > .startup-webview-placeholder[hidden],
+.monaco-workbench:has(> .monaco-modal-editor-block) > .startup-webview-placeholder { display: none; }
+.monaco-workbench.blocking-webview *,
+.monaco-workbench.blocking-webview *:focus,
+.monaco-workbench.blocking-webview *:focus-visible { outline: none !important; }
