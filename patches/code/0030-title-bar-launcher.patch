+import { addDisposableListener, EventType, getWindow } from '../../../../base/browser/dom.js';
+import { StandardMouseEvent } from '../../../../base/browser/mouseEvent.js';
+import { IAction, Separator, toAction } from '../../../../base/common/actions.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { localize } from '../../../../nls.js';
+import { IActionViewItemService } from '../../../../platform/actions/browser/actionViewItemService.js';
+import { MenuEntryActionViewItem } from '../../../../platform/actions/browser/menuEntryActionViewItem.js';
+import { MenuId, MenuItemAction, MenuRegistry } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ContextKeyExpr } from '../../../../platform/contextkey/common/contextkey.js';
+import { IInstantiationService } from '../../../../platform/instantiation/common/instantiation.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IsAuxiliaryWindowContext } from '../../../common/contextkeys.js';
+
+const OBSIDIAN_OPEN = 'arara.obsidian.open';
+const OBSIDIAN_SYNC = 'arara.obsidian.sync';
+
+MenuRegistry.appendMenuItem(MenuId.LayoutControlMenu, {
+	group: 'navigation',
+	order: -2,
+	command: {
+		id: 'arara.ui.titleLauncher.run',
+		title: localize('arara.ui.titleLauncher', "Arara"),
+		icon: Codicon.sparkle,
+	},
+	when: ContextKeyExpr.and(IsAuxiliaryWindowContext.negate(), ContextKeyExpr.has('arara.ui.titleLauncher')),
+});
+
+MenuRegistry.appendMenuItem(MenuId.LayoutControlMenu, {
+	group: 'navigation',
+	order: -0.5,
+	command: {
+		id: OBSIDIAN_OPEN,
+		title: localize('arara.obsidian.open', "Open Obsidian"),
+		icon: Codicon.ruby,
+	},
+	when: ContextKeyExpr.and(IsAuxiliaryWindowContext.negate(), ContextKeyExpr.has('arara.obsidian.available')),
+});
+
+for (const id of [MenuId.MenubarPreferencesMenu, MenuId.GlobalActivity]) {
+	MenuRegistry.appendMenuItem(id, {
+		group: '2_configuration',
+		order: 2.5,
+		command: {
+			id: 'arara.openSettings',
+			title: localize('arara.openSettings', "Arara settings"),
+		},
+		when: ContextKeyExpr.has('arara.ui.titleLauncher'),
+	});
+}
+
+class AraraLauncherActionViewItem extends MenuEntryActionViewItem {
+
+	extraActions: IAction[] = [];
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+		this._register(addDisposableListener(container, EventType.CONTEXT_MENU, e => {
+			const event = new StandardMouseEvent(getWindow(container), e);
+			event.preventDefault();
+			event.stopPropagation();
+			const action = this._menuItemAction;
+			const primary = [toAction({ id: action.id, label: action.label, run: () => action.run() }), ...this.extraActions];
+			const actions = action.hideActions ? Separator.join(primary, [action.hideActions.hide]) : primary;
+			this._contextMenuService.showContextMenu({
+				getAnchor: () => event,
+				getActions: () => actions,
+				menuId: MenuId.TitleBarContext,
+				contextKeyService: this._contextKeyService,
+			});
+		}));
+	}
+}
+
+class AraraTitleLauncherContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.araraTitleLauncher';
+
+	constructor(
+		@IActionViewItemService actionViewItemService: IActionViewItemService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@ICommandService commandService: ICommandService,
+	) {
+		super();
+		this._register(actionViewItemService.register(MenuId.LayoutControlMenu, OBSIDIAN_OPEN, (action, options) => {
+			if (!(action instanceof MenuItemAction)) {
+				return undefined;
+			}
+			const item = instantiationService.createInstance(AraraLauncherActionViewItem, action, options);
+			item.extraActions = [toAction({ id: OBSIDIAN_SYNC, label: localize('arara.obsidian.sync', "Sync Obsidian vault"), run: () => commandService.executeCommand(OBSIDIAN_SYNC) })];
+			return item;
+		}));
+	}
+}
+
+registerWorkbenchContribution2(AraraTitleLauncherContribution.ID, AraraTitleLauncherContribution, WorkbenchPhase.BlockRestore);
