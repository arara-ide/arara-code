 .monaco-workbench .xterm.terminal.hide {
 	visibility: hidden;
 }
+
+/* Arara Code: terminal sendo preenchido pela IA (context key arara.terminalStreaming).
+   Escurece a tela do terminal e passa um brilho; a execução fica travada (o Enter é
+   engolido por keybinding da extensão enquanto esta classe está presente). */
+.monaco-workbench .pane-body.integrated-terminal.arara-streaming .terminal-outer-container {
+	position: relative;
+}
+
+.monaco-workbench .pane-body.integrated-terminal.arara-streaming .xterm .xterm-screen {
+	opacity: 0.55;
+	transition: opacity 120ms ease;
+}
+
+.monaco-workbench .pane-body.integrated-terminal.arara-streaming .terminal-outer-container::after {
+	content: "";
+	position: absolute;
+	inset: 0;
+	pointer-events: none;
+	z-index: 10;
+	background: linear-gradient(
+		100deg,
+		transparent 30%,
+		var(--vscode-terminal-foreground, rgba(255, 255, 255, 0.12)) 50%,
+		transparent 70%
+	);
+	opacity: 0.12;
+	background-size: 300% 100%;
+	animation: arara-terminal-shine 1.4s linear infinite;
+}
+
+@keyframes arara-terminal-shine {
+	from { background-position: 180% 0; }
+	to { background-position: -80% 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+	.monaco-workbench .pane-body.integrated-terminal.arara-streaming .terminal-outer-container::after {
+		animation: none;
+	}
+}
