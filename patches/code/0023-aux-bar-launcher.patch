+	protected override createHeaderArea(): HTMLElement {
+		const area = super.createHeaderArea();
+		this.contextKeyService.createKey('arara.ui.auxLauncherAvailable', true);
+		const button = $('button.arara-aux-launcher', { type: 'button' });
+		const iconEl = append(button, $('span'));
+		iconEl.className = ThemeIcon.asClassName(Codicon.wand);
+		const label = append(button, $('span.label'));
+		area.appendChild(button);
+		const update = () => {
+			const text = this.contextKeyService.getContextKeyValue<string>('arara.ui.auxLauncher');
+			button.hidden = typeof text !== 'string' || !text;
+			label.textContent = text || '';
+			button.title = text || '';
+		};
+		update();
+		this.headerFooterCompositeBarDispoables.add(this.contextKeyService.onDidChangeContext(e => {
+			if (e.affectsSome(new Set(['arara.ui.auxLauncher']))) { update(); }
+		}));
+		this.headerFooterCompositeBarDispoables.add(addDisposableListener(button, 'click', () => {
+			this.commandService.executeCommand('arara.ui.auxLauncher.run').catch(error => this.launcherNotificationService.error(error));
+		}));
+		return area;
+	}
