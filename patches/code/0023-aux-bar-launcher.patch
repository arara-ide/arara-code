+	protected override createHeaderArea(): HTMLElement {
+		const area = super.createHeaderArea();
+		this.contextKeyService.createKey('arara.ui.auxLauncherAvailable', true);
+		const group = append(area, $('span.arara-aux-launchers'));
+		const clicksKey = 'arara.ui.auxLauncher.clicks';
+		const clicks = (): Record<string, number> => { try { return JSON.parse(this.launcherStorageService.get(clicksKey, StorageScope.PROFILE, '{}')); } catch { return {}; } };
+		const make = (key: string, iconClass: string) => {
+			const button = append(group, $('button.arara-aux-launcher', { type: 'button' }));
+			const iconEl = append(button, $('span'));
+			iconEl.className = iconClass;
+			const label = append(button, $('span.label'));
+			const update = () => {
+				const text = this.contextKeyService.getContextKeyValue<string>(key);
+				button.hidden = typeof text !== 'string' || !text;
+				label.textContent = text || '';
+				button.title = text || '';
+				button.setAttribute('aria-label', text || '');
+			};
+			update();
+			this.headerFooterCompositeBarDispoables.add(this.contextKeyService.onDidChangeContext(e => {
+				if (e.affectsSome(new Set([key]))) { update(); fit(); }
+			}));
+			this.headerFooterCompositeBarDispoables.add(addDisposableListener(button, 'click', () => {
+				const count = clicks();
+				count[key] = (count[key] ?? 0) + 1;
+				this.launcherStorageService.store(clicksKey, JSON.stringify(count), StorageScope.PROFILE, StorageTarget.USER);
+				this.commandService.executeCommand(`${key}.run`).catch(error => this.launcherNotificationService.error(error));
+			}));
+			return { key, button };
+		};
+		const second = make('arara.ui.auxLauncher2', 'arara-aux-icon-arara');
+		const first = make('arara.ui.auxLauncher', ThemeIcon.asClassName(Codicon.wand));
+		const fit = () => {
+			for (const b of [first, second]) b.button.classList.remove('icon-only');
+			const bar = area.querySelector<HTMLElement>('.composite-bar-container');
+			const tight = () => area.scrollWidth > area.clientWidth + 1 || (!!bar && bar.scrollWidth > bar.clientWidth + 1);
+			const count = clicks();
+			const ranked = [first, second].filter(item => !item.button.hidden).sort((a, b) => (count[a.key] ?? 0) - (count[b.key] ?? 0));
+			for (const item of ranked) {
+				if (!tight()) { break; }
+				item.button.classList.add('icon-only');
+			}
+		};
+		const observer = new ResizeObserver(() => fit());
+		observer.observe(area);
+		this.headerFooterCompositeBarDispoables.add({ dispose: () => observer.disconnect() });
+		fit();
+		return area;
+	}
