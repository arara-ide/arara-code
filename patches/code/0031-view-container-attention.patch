+// Generic extension hook: the extension owns the attention state and supplies a theme color token.
+const viewContainerAttention = new Map<string, string>();
+const viewContainerAttentionChanged = new Emitter<string>();
+CommandsRegistry.registerCommand('_workbench.setViewContainerAttention', (_accessor, id: unknown, color: unknown) => {
+	if (typeof id !== 'string' || !id || (color !== undefined && color !== null && (typeof color !== 'string' || !color))) {
+		return;
+	}
+	if (typeof color === 'string') {
+		viewContainerAttention.set(id, color);
+	} else {
+		viewContainerAttention.delete(id);
+	}
+	viewContainerAttentionChanged.fire(id);
+});
