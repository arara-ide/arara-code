+type ViewContainerAttention = string | { shine: true; delay: string };
+const viewContainerAttention = new Map<string, ViewContainerAttention>();
+const viewContainerAttentionChanged = new Emitter<string>();
+CommandsRegistry.registerCommand('_workbench.setViewContainerAttention', (_accessor, id: unknown, attention: unknown) => {
+	if (typeof id !== 'string' || !id) {
+		return;
+	}
+	if (typeof attention === 'string' && attention) {
+		viewContainerAttention.set(id, attention);
+	} else if (attention && typeof attention === 'object' && (attention as { shine?: unknown }).shine === true) {
+		const existing = viewContainerAttention.get(id);
+		const delay = typeof existing === 'object' ? existing.delay : `${(-Math.random() * 1.8).toFixed(3)}s`;
+		viewContainerAttention.set(id, { shine: true, delay });
+	} else if (attention === undefined || attention === null) {
+		viewContainerAttention.delete(id);
+	} else {
+		return;
+	}
+	viewContainerAttentionChanged.fire(id);
+});
