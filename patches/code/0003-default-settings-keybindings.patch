+/*---------------------------------------------------------------------------------------------
+ *  Arara Code: os atalhos padrão do produto parseiam e as remoções ("-cmd") batem
+ *  com atalhos padrão reais do VS Code.
+ *  Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';
+import { KeybindingIO } from '../../services/keybinding/common/keybindingIO.js';
+import { araraDefaultKeybindings } from '../../common/arara.defaults.js';
+
+suite('Arara default keybindings', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('every entry parses (key and when)', () => {
+		for (const k of araraDefaultKeybindings) {
+			const item = KeybindingIO.readUserKeybindingItem(k);
+			assert.ok(item.command, `command missing: ${JSON.stringify(k)}`);
+			if (k.key) {
+				assert.ok(item.keybinding, `key did not parse: ${k.key}`);
+			}
+			if (k.when) {
+				assert.ok(item.when, `when did not parse: ${k.when}`);
+			}
+		}
+	});
+
+	test('no entry references third-party extensions', () => {
+		const thirdParty = /^-?(github\.copilot|aws\.|amazonq|windsurf|devin|composer\.|aichat|aipopup|extension\.translate)/;
+		for (const k of araraDefaultKeybindings) {
+			assert.ok(!thirdParty.test(k.command), `third-party command in defaults: ${k.command}`);
+		}
+	});
+});
