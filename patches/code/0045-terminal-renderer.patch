+import { ITerminalContribution, IXtermTerminal } from './terminal.js';
+import { ITerminalContributionContext, registerTerminalContribution } from './terminalExtensions.js';
+
+class TerminalRenderer extends Disposable implements ITerminalContribution {
+	static readonly ID = 'arara.terminal.renderer';
+	private _xterm: IXtermTerminal | undefined;
+	private _loading = false;
+	private _attached = false;
+
+	constructor(
+		private readonly _ctx: ITerminalContributionContext,
+		@ICommandService private readonly _commands: ICommandService,
+		@IContextKeyService private readonly _contextKeys: IContextKeyService,
+		@IInstantiationService private readonly _instantiation: IInstantiationService,
+	) {
+		super();
+		this._register(_ctx.instance.onDidFocus(() => { void this._attach(); }));
+	}
+
+	xtermOpen(xterm: IXtermTerminal): void {
+		this._xterm = xterm;
+		void this._attach();
+	}
+
+	private async _attach(): Promise<void> {
+		if (!this._xterm || this._loading || this._attached || this._store.isDisposed) { return; }
+		this._loading = true;
+		try {
+			const descriptor = await this._commands.executeCommand<{ version: number; module: string; tab: string; label: string }>('arara.terminal.renderer', 1);
+			if (!descriptor || descriptor.version !== 1 || typeof descriptor.module !== 'string' || typeof descriptor.tab !== 'string' || typeof descriptor.label !== 'string') { return; }
+			const uri = URI.parse(descriptor.module);
+			if (uri.scheme !== Schemas.file && uri.scheme !== Schemas.vscodeRemote) { return; }
+			const renderer = await import(FileAccess.uriToBrowserUri(uri).toString(true)) as { attach(host: unknown): IDisposable };
+			if (this._store.isDisposed || typeof renderer.attach !== 'function') { return; }
+			this._register(renderer.attach({
+				version: 1, labels: { tab: descriptor.tab, label: descriptor.label },
+				instance: this._ctx.instance, xterm: this._xterm, commandDetection: TerminalCapability.CommandDetection,
+				executeCommand: (command: string, request: unknown) => this._commands.executeCommand(command, request),
+				tabMovesFocus: () => TabFocus.getTabFocusMode(),
+				getContext: (key: string) => this._contextKeys.getContextKeyValue(key),
+				readShellHistory: async () => {
+					const history = await this._instantiation.invokeFunction(getShellFileHistory, this._ctx.instance.shellType, true);
+					return { scope: history?.sourceResource.toString() ?? this._ctx.instance.shellType ?? 'terminal', commands: history?.commands ?? [] };
+				},
+			}));
+			this._attached = true;
+		} catch {} finally {
+			this._loading = false;
+		}
+	}
+}
+
+registerTerminalContribution(TerminalRenderer.ID, TerminalRenderer);
