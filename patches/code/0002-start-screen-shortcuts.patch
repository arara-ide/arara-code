+/* Arara Code: tela inicial do editor vazio (atalhos clicáveis) */
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.arara-start {
+	max-width: 720px;
+	padding: 0 24px;
+}
+
+.monaco-workbench .part.editor > .content .editor-group-container > .editor-group-watermark-wrapper > .editor-group-watermark.arara-start .letterpress {
+	max-width: 96px;
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-title {
+	margin: 0 0 20px;
+	text-align: center;
+	font-size: 22px;
+	font-weight: 600;
+	color: var(--vscode-foreground);
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-grid {
+	display: grid;
+	grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+	gap: 20px 32px;
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-section h2 {
+	margin: 0 0 6px;
+	font-size: 11px;
+	font-weight: 600;
+	letter-spacing: 0.06em;
+	text-transform: uppercase;
+	color: var(--vscode-descriptionForeground);
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-section ul {
+	list-style: none;
+	margin: 0;
+	padding: 0;
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-item {
+	display: flex;
+	width: 100%;
+	align-items: center;
+	justify-content: space-between;
+	gap: 12px;
+	padding: 4px 8px;
+	margin: 0 -8px;
+	border: 0;
+	border-radius: 4px;
+	background: none;
+	color: var(--vscode-textLink-foreground);
+	font: inherit;
+	text-align: left;
+	cursor: pointer;
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-item:hover {
+	background: var(--vscode-list-hoverBackground);
+	color: var(--vscode-textLink-activeForeground);
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-item:focus-visible {
+	outline: 1px solid var(--vscode-focusBorder);
+	outline-offset: -1px;
+}
+
+.monaco-workbench .editor-group-watermark.arara-start .arara-start-keys {
+	flex-shrink: 0;
+	color: var(--vscode-descriptionForeground);
+}
