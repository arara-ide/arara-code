 			// TODO See if it's possible to bundle vscode-languagedetection
 			useAsar
-				? FileAccess.asBrowserUri(`${moduleLocationAsar}/dist/lib/index.js`).toString(true)
-				: FileAccess.asBrowserUri(`${moduleLocation}/dist/lib/index.js`).toString(true),
+				? FileAccess.asBrowserUri(`${moduleLocationAsar}/dist/lib/index.browser.js`).toString(true)
+				: FileAccess.asBrowserUri(`${moduleLocation}/dist/lib/index.browser.js`).toString(true),
 			useAsar
