Arara Code: request local-network-access only on engines supporting the policy.

Why a patch: the outer webview iframe and its preload document are owned by the
workbench; extension APIs cannot configure their permissions policy. Feature
detection keeps the permission on supporting engines and leaves other policies,
sandbox rules and webview messaging unchanged.
Touches: webviewElement.ts, webview/browser/pre/index.html.

--- a/src/vs/workbench/contrib/webview/browser/webviewElement.ts
+++ b/src/vs/workbench/contrib/webview/browser/webviewElement.ts
@@ -420,7 +420,10 @@
 		element.className = `webview ${options.customClasses || ''}`;
 		element.sandbox.add('allow-scripts', 'allow-same-origin', 'allow-forms', 'allow-pointer-lock', 'allow-downloads');
 
-		const allowRules = ['cross-origin-isolated', 'autoplay', 'local-network-access'];
+		const allowRules = ['cross-origin-isolated', 'autoplay'];
+		if ((document as Document & { featurePolicy?: { features(): string[] } }).featurePolicy?.features().includes('local-network-access')) {
+			allowRules.push('local-network-access');
+		}
 		if (!isFirefox) {
 			allowRules.push('clipboard-read', 'clipboard-write');
 		}
--- a/src/vs/workbench/contrib/webview/browser/pre/index.html
+++ b/src/vs/workbench/contrib/webview/browser/pre/index.html
@@ -1031,7 +1031,10 @@
 				}
 				newFrame.setAttribute('sandbox', Array.from(sandboxRules).join(' '));
 
-				const allowRules = ['cross-origin-isolated;', 'autoplay;', 'local-network-access;'];
+				const allowRules = ['cross-origin-isolated;', 'autoplay;'];
+				if (document.featurePolicy?.features().includes('local-network-access')) {
+					allowRules.push('local-network-access;');
+				}
 				if (!isFirefox && options.allowScripts) {
 					allowRules.push('clipboard-read;', 'clipboard-write;');
 				}
