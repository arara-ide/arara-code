+async function getBuiltinLanguagePackConfigurations(extensionsPath: string): Promise<ILanguagePacks | undefined> {
+	const languagePacks: ILanguagePacks = {};
+	try {
+		for (const folder of await promises.readdir(extensionsPath)) {
+			const location = join(extensionsPath, folder);
+			let manifest;
+			try { manifest = JSON.parse(await promises.readFile(join(location, 'package.json'), 'utf-8')); } catch { continue; }
+			const id = `${manifest.publisher}.${manifest.name}`.toLowerCase();
+			for (const localization of manifest.contributes?.localizations ?? []) {
+				if (typeof localization?.languageId !== 'string' || !Array.isArray(localization.translations)) { continue; }
+				const translations: Record<string, string> = {};
+				for (const translation of localization.translations) {
+					if (typeof translation?.id === 'string' && typeof translation?.path === 'string') { translations[translation.id] = join(location, translation.path); }
+				}
+				const languageId = localization.languageId.toLowerCase();
+				languagePacks[languageId] = { hash: createHash('md5').update(id).update(manifest.version).digest('hex'), extensions: [{ extensionIdentifier: { id }, version: manifest.version }], translations, label: localization.localizedLanguageName ?? localization.languageName };
+			}
+		}
+	} catch {
+		return undefined;
+	}
+	return Object.keys(languagePacks).length ? languagePacks : undefined;
+}
