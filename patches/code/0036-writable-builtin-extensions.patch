+++ b/src/vs/platform/extensionManagement/common/writableBuiltinExtensions.ts
@@ -0,0 +1,33 @@
+import { joinPath } from '../../../base/common/resources.js';
+import { URI } from '../../../base/common/uri.js';
+import { generateUuid } from '../../../base/common/uuid.js';
+import { IFileService } from '../../files/common/files.js';
+import { ILogService } from '../../log/common/log.js';
+import { IScannedExtension } from './extensionsScannerService.js';
+
+export async function prepareWritableBuiltinExtension(extension: IScannedExtension, storageHome: URI, build: string, fileService: IFileService, logService: ILogService): Promise<IScannedExtension> {
+	const parent = joinPath(storageHome, 'builtin-extensions', encodeURIComponent(extension.identifier.id.toLowerCase()));
+	const location = joinPath(parent, encodeURIComponent(`${extension.manifest.version}-${build}`));
+	const staging = joinPath(parent, `.staging-${generateUuid()}`);
+	try {
+		if (!await fileService.exists(joinPath(location, 'package.json'))) {
+			await fileService.createFolder(parent);
+			await fileService.copy(extension.location, staging, false);
+			try {
+				await fileService.move(staging, location, false);
+			} catch (error) {
+				if (!await fileService.exists(joinPath(location, 'package.json'))) {
+					throw error;
+				}
+			}
+		}
+		return { ...extension, location };
+	} catch (error) {
+		logService.error(`Unable to prepare writable builtin extension ${extension.identifier.id}`, error);
+		return extension;
+	} finally {
+		if (await fileService.exists(staging)) {
+			await fileService.del(staging, { recursive: true }).catch(error => logService.error(error));
+		}
+	}
+}
