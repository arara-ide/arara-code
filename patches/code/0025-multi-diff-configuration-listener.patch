+export class MultiDiffEditorConfigurationChangeDispatcher implements IDisposable {
+	private readonly _listeners = new Map<string, { resource: URI; listeners: Set<() => void> }>();
+	private readonly _configurationService: ITextResourceConfigurationService;
+	private _subscription: IDisposable | undefined;
+
+	constructor(configurationService: ITextResourceConfigurationService) {
+		this._configurationService = configurationService;
+	}
+
+	public onDidChange(resource: URI, listener: () => void): IDisposable {
+		const key = resource.toString();
+		let bucket = this._listeners.get(key);
+		if (!bucket) {
+			bucket = { resource, listeners: new Set() };
+			this._listeners.set(key, bucket);
+		}
+		bucket.listeners.add(listener);
+		this._subscription ??= this._configurationService.onDidChangeConfiguration(this._handleEventChange);
+
+		return toDisposable(() => {
+			bucket!.listeners.delete(listener);
+			if (bucket!.listeners.size === 0) {
+				this._listeners.delete(key);
+			}
+			if (this._listeners.size === 0) {
+				this._subscription?.dispose();
+				this._subscription = undefined;
+			}
+		});
+	}
+
+	public dispose(): void {
+		this._subscription?.dispose();
+		this._subscription = undefined;
+		this._listeners.clear();
+	}
+
+	private readonly _handleEventChange = (event: ITextResourceConfigurationChangeEvent): void => {
+		for (const { resource, listeners } of this._listeners.values()) {
+			if (!event.affectsConfiguration(resource, 'editor') && !event.affectsConfiguration(resource, 'diffEditor')) {
+				continue;
+			}
+			for (const listener of listeners) {
+				listener();
+			}
+		}
+	};
+}
+
 /**
  * Uses a map to efficiently dispatch events to listeners that are interested in a specific key.
 */
