+		const timer = this._register(new IntervalTimer());
+		timer.cancelAndSet(() => void this.check(), POLL_MS, mainWindow);
+		this._register(hostService.onDidChangeFocus(focused => focused && void this.check()));
+	}
+
+	private async check(): Promise<void> {
+		if (this.handled) {
+			return;
+		}
+		let onDisk: string | undefined;
+		try {
+			const raw = (await this.fileService.readFile(this.productJson)).value.toString();
+			const v = (JSON.parse(raw) as { version?: unknown }).version;
+			onDisk = typeof v === 'string' ? v : undefined;
