+			// no meio do dpkg o arquivo some/fica pela metade; tenta no próximo ciclo
+			this.seen = undefined;
+			return;
+		}
+		if (!onDisk || onDisk === this.productService.version) {
+			this.seen = undefined;
+			return;
+		}
+		if (this.seen !== onDisk) {
+			this.seen = onDisk; // espera a próxima leitura confirmar
+			return;
+		}
+
+		this.handled = true;
+		this.installed.set(true);
+		this.logService.info(`[arara] versão ${onDisk} instalada no disco (rodando ${this.productService.version}); reiniciando`);
