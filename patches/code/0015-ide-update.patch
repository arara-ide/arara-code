+		const windows = await this.nativeHostService.getWindows({ includeAuxiliaryWindows: false });
+		if (Math.min(...windows.map(w => w.id)) !== this.nativeHostService.windowId) {
+			return;
+		}
+		void this.countdown(onDisk);
+	}
+
+	private aiRunning(): boolean {
+		return AI_RUNNING_KEYS.some(k => this.contextKeyService.getContextKeyValue<boolean>(k) === true);
+	}
+
+	private async countdown(version: string): Promise<void> {
+		let cancelled = false;
+		const message = (s: number) => this.aiRunning()
+			? localize('arara.update.waitingAi', "Arara Code {0} foi instalado. Reinicia assim que a IA terminar a resposta.", version)
+			: localize('arara.update.countdown', "Arara Code {0} foi instalado. Reiniciando em {1} s para aplicar a atualização.", version, s);
+
+		const handle: INotificationHandle = this.notificationService.prompt(Severity.Info, message(COUNTDOWN_S), [
+			{ label: localize('arara.update.now', "Reiniciar agora"), run: () => { cancelled = true; void this.nativeHostService.relaunch(); } },
+			{ label: localize('arara.update.later', "Depois"), run: () => { cancelled = true; } },
+		], { sticky: true, priority: NotificationPriority.URGENT, onCancel: () => { cancelled = true; } });
+		this.prompt.value = toDisposable(() => handle.close());
