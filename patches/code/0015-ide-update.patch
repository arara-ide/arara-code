+			while (!cancelled && this.aiRunning()) {
+				handle.updateMessage(message(s));
+				await timeout(1000);
+			}
+			if (cancelled) {
+				return;
+			}
+			handle.updateMessage(message(s));
+			await timeout(1000);
+		}
+		if (!cancelled) {
+			handle.close();
+			await this.nativeHostService.relaunch();
+		}
+	}
+}
