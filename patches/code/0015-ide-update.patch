+/* Arara Code: botão "Atualizar" / "Reiniciar para atualizar" na barra de título (ao lado do Customize Layout). */
+.monaco-workbench .part.titlebar .action-item.arara-update-action > .action-label {
+	display: flex;
+	align-items: center;
+	gap: 4px;
+	width: auto;
+	padding: 0 8px;
+	border-radius: 4px;
+	font-size: 12px;
+	white-space: nowrap;
+	color: var(--vscode-button-foreground);
+	background-color: var(--vscode-button-background);
+}
+
+.monaco-workbench .part.titlebar .action-item.arara-update-action > .action-label:hover {
+	background-color: var(--vscode-button-hoverBackground);
+}
+
+.monaco-workbench .part.titlebar .action-item.arara-update-action > .action-label .codicon {
+	color: inherit;
+	font-size: 14px;
+}

