+import './media/araraUpdate.css';
+import { reset } from '../../../../base/browser/dom.js';
+import { renderLabelWithIcons } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { IntervalTimer, timeout } from '../../../../base/common/async.js';
+import { Disposable, MutableDisposable, toDisposable } from '../../../../base/common/lifecycle.js';
+import { joinPath } from '../../../../base/common/resources.js';
+import { URI } from '../../../../base/common/uri.js';
+import { mainWindow } from '../../../../base/browser/window.js';
+import { isLinux } from '../../../../base/common/platform.js';
+import { localize, localize2 } from '../../../../nls.js';
+import { IActionViewItemService } from '../../../../platform/actions/browser/actionViewItemService.js';
+import { MenuEntryActionViewItem } from '../../../../platform/actions/browser/menuEntryActionViewItem.js';
+import { Action2, MenuId, MenuItemAction, MenuRegistry, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ContextKeyExpr, IContextKeyService, RawContextKey } from '../../../../platform/contextkey/common/contextkey.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { INativeHostService } from '../../../../platform/native/common/native.js';
+import { INotificationHandle, INotificationService, NotificationPriority, Severity } from '../../../../platform/notification/common/notification.js';
+import { IProductService } from '../../../../platform/product/common/productService.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IsAuxiliaryWindowContext } from '../../../common/contextkeys.js';
+import { INativeWorkbenchEnvironmentService } from '../../../services/environment/electron-browser/environmentService.js';
+import { IHostService } from '../../../services/host/browser/host.js';
+
+const UpdateAvailable = new RawContextKey<boolean>('arara.update.available', false);
+const UpdateInstalled = new RawContextKey<boolean>('arara.update.installed', false, localize('arara.update.installed', "A newer Arara Code is installed and waits for a restart"));
+const UpdateBusy = new RawContextKey<boolean>('arara.update.busy', false);
+
+const OPEN_COMMAND = 'arara.update.open';
+const RESTART_COMMAND = 'arara.update.restart';
+const UPDATING_COMMAND = 'arara.update.updating';
+const POLL_MS = 30_000;
+const COUNTDOWN_S = 10;
+const AI_RUNNING_KEYS = ['arara.chat.running', 'arara.codex.running', 'arara.claude.running', 'arara.antigravity.running', 'arara.kiro.running', 'arara.opencode.running'];
+
+const notInAuxWindow = IsAuxiliaryWindowContext.negate();
+
+function restart(nativeHostService: INativeHostService): Promise<void> {
+	return isLinux ? nativeHostService.quit() : nativeHostService.relaunch();
+}
+
+MenuRegistry.appendMenuItem(MenuId.LayoutControlMenu, {
+	group: 'navigation',
+	order: -1,
+	command: { id: OPEN_COMMAND, title: localize('arara.update.open', "Update") },
+	when: ContextKeyExpr.and(notInAuxWindow, UpdateAvailable, UpdateBusy.negate(), UpdateInstalled.negate()),
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: UPDATING_COMMAND,
+			title: localize2('arara.update.updating', "Updating"),
+			precondition: ContextKeyExpr.false(),
+			menu: { id: MenuId.LayoutControlMenu, group: 'navigation', order: -1, when: ContextKeyExpr.and(notInAuxWindow, UpdateBusy, UpdateInstalled.negate()) },
+		});
+	}
+	run(): void { }
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: RESTART_COMMAND,
+			title: isLinux ? localize2('arara.update.close', "Close to update") : localize2('arara.update.restart', "Restart to update"),
+			f1: true,
+			precondition: UpdateInstalled,
+			menu: { id: MenuId.LayoutControlMenu, group: 'navigation', order: -1, when: ContextKeyExpr.and(notInAuxWindow, UpdateInstalled) },
+		});
+	}
+	run(accessor: ServicesAccessor): Promise<void> {
+		return restart(accessor.get(INativeHostService));
+	}
+});
+
+class AraraUpdateActionViewItem extends MenuEntryActionViewItem {
+	override render(container: HTMLElement): void {
+		super.render(container);
+		container.classList.add('arara-update-action');
+	}
+
+	protected override updateLabel(): void {
+		if (!this.label) {
+			return;
+		}
+		const icon = this._commandAction.id === RESTART_COMMAND ? '$(debug-restart)' : this._commandAction.id === UPDATING_COMMAND ? '$(loading~spin)' : '$(cloud-download)';
+		reset(this.label, ...renderLabelWithIcons(`${icon} ${this._commandAction.label}`));
+	}
+}
+
+export class AraraUpdateContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.araraUpdate';
+
+	private readonly installed = UpdateInstalled.bindTo(this.contextKeyService);
+	private readonly productJson: URI;
+	private seen: string | undefined;
+	private handled = false;
+	private readonly prompt = this._register(new MutableDisposable());
+
+	constructor(
+		@IActionViewItemService actionViewItemService: IActionViewItemService,
+		@IInstantiationService instantiationService: IInstantiationService,
+		@IContextKeyService private readonly contextKeyService: IContextKeyService,
+		@IFileService private readonly fileService: IFileService,
+		@INativeWorkbenchEnvironmentService environmentService: INativeWorkbenchEnvironmentService,
+		@IProductService private readonly productService: IProductService,
+		@INativeHostService private readonly nativeHostService: INativeHostService,
+		@INotificationService private readonly notificationService: INotificationService,
+		@IHostService hostService: IHostService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+
+		for (const id of [OPEN_COMMAND, UPDATING_COMMAND, RESTART_COMMAND]) {
+			this._register(actionViewItemService.register(MenuId.LayoutControlMenu, id, (action, options) =>
+				action instanceof MenuItemAction ? instantiationService.createInstance(AraraUpdateActionViewItem, action, options) : undefined
+			));
+		}
+
+		this.productJson = joinPath(URI.file(environmentService.appRoot), 'product.json');
+
+		if (!environmentService.isBuilt) {
+			return;
+		}
+
+		const timer = this._register(new IntervalTimer());
+		timer.cancelAndSet(() => void this.check(), POLL_MS, mainWindow);
+		this._register(hostService.onDidChangeFocus(focused => focused && void this.check()));
+	}
+
+	private async check(): Promise<void> {
+		if (this.handled) {
+			return;
+		}
+		let onDisk: string | undefined;
+		try {
+			const raw = (await this.fileService.readFile(this.productJson)).value.toString();
+			const v = (JSON.parse(raw) as { version?: unknown }).version;
+			onDisk = typeof v === 'string' ? v : undefined;
+		} catch {
+			this.seen = undefined;
+			return;
+		}
+		if (!onDisk || onDisk === this.productService.version) {
+			this.seen = undefined;
+			return;
+		}
+		if (this.seen !== onDisk) {
+			this.seen = onDisk;
+			return;
+		}
+
+		this.handled = true;
+		this.installed.set(true);
+		this.logService.info(`[arara] versão ${onDisk} instalada no disco (rodando ${this.productService.version}); reiniciando`);
+
+		const windows = await this.nativeHostService.getWindows({ includeAuxiliaryWindows: false });
+		if (Math.min(...windows.map(w => w.id)) !== this.nativeHostService.windowId) {
+			return;
+		}
+		void this.countdown(onDisk);
+	}
+
+	private aiRunning(): boolean {
+		return AI_RUNNING_KEYS.some(k => this.contextKeyService.getContextKeyValue<boolean>(k) === true);
+	}
+
+	private async countdown(version: string): Promise<void> {
+		let cancelled = false;
+		const message = (s: number) => this.aiRunning()
+			? (isLinux
+				? localize('arara.update.waitingAiClose', "Arara Code {0} is installed. It will close when the AI finishes responding; then reopen Arara Code.", version)
+				: localize('arara.update.waitingAi', "Arara Code {0} is installed. It will restart when the AI finishes responding.", version))
+			: isLinux
+				? localize('arara.update.countdownClose', "Arara Code {0} is installed. Closing in {1} s to apply the update; then reopen Arara Code.", version, s)
+				: localize('arara.update.countdown', "Arara Code {0} is installed. Restarting in {1} s to apply the update.", version, s);
+
+		const handle: INotificationHandle = this.notificationService.prompt(Severity.Info, message(COUNTDOWN_S), [
+			{ label: isLinux ? localize('arara.update.closeNow', "Close now") : localize('arara.update.now', "Restart now"), run: () => { cancelled = true; void restart(this.nativeHostService); } },
+			{ label: localize('arara.update.later', "Later"), run: () => { cancelled = true; } },
+		], { sticky: true, priority: NotificationPriority.URGENT, onCancel: () => { cancelled = true; } });
+		this.prompt.value = toDisposable(() => handle.close());
+
+		for (let s = COUNTDOWN_S; s > 0; s--) {
+			while (!cancelled && this.aiRunning()) {
+				handle.updateMessage(message(s));
+				await timeout(1000);
+			}
+			if (cancelled) {
+				return;
+			}
+			handle.updateMessage(message(s));
+			await timeout(1000);
+		}
+		if (!cancelled) {
+			handle.close();
+			await restart(this.nativeHostService);
+		}
+	}
+}
+
+registerWorkbenchContribution2(AraraUpdateContribution.ID, AraraUpdateContribution, WorkbenchPhase.Eventually);
