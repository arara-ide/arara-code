 export function registerTerminalActions() {
+	// Generic read-only bridge: interpretation and attachment policy belong to the extension.
+	registerTerminalAction({
+		id: 'arara.internal.terminalSnapshot',
+		title: localize2('arara.terminalSnapshot', 'Read Terminal Buffer'),
+		f1: false,
+		run: async (c, _, id) => {
+			const instance = typeof id === 'number' ? c.service.instances.find(item => item.instanceId === id) : c.service.activeInstance;
+			const raw = instance?.xterm?.raw;
+			if (!instance || !raw) { return undefined; }
+			const buffer = raw.buffer.active;
+			const end = Math.min(buffer.length, buffer.baseY + buffer.cursorY + 1);
+			const firstLine = Math.max(0, end - 1000);
+			const lines: string[] = [];
+			for (let i = firstLine; i < end; i++) { lines.push(buffer.getLine(i)?.translateToString(true) ?? ''); }
+			const detection = instance.capabilities.get(TerminalCapability.CommandDetection);
+			const commands = [...(detection?.commands ?? [])];
+			if (detection?.executingCommandObject) { commands.push(detection.executingCommandObject); }
+			return { id: instance.instanceId, name: instance.title, selection: raw.getSelection(), lines, firstLine,
+				commandLines: commands.map(command => command.marker?.line ?? -1).filter(line => line >= 0) };
+		}
+	});
