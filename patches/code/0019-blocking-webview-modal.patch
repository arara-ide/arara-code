 	async executeCommand<T>(id: string, ...args: unknown[]): Promise<T> {
+		// Blocking extension-owned modal: commands are admitted centrally, so native
+		// menus, custom shortcuts and webview-forwarded keybindings share the gate.
+		if (this._contextKeyService.getContextKeyValue('arara.modal.viewType') && id !== 'setContext') {
+			const allowed = this._contextKeyService.getContextKeyValue<readonly string[]>('arara.modal.allowedCommands');
+			if (!allowed?.includes(id)) { return undefined as T; }
+		}
 		this._logService.trace('CommandService#executeCommand', id);
 
 		const activationEvent = `onCommand:${id}`;
