+function clearQuickPickDecorations(data: IQuickInputItemTemplateData): void {
+	data.badges?.remove();
+	data.badges = undefined;
+	data.meters?.remove();
+	data.meters = undefined;
+}
+
+function renderQuickPickBadges(item: IQuickPickItem, data: IQuickInputItemTemplateData): void {
+	if (!item.badges?.length) {
+		return;
+	}
+
+	const badges = $('.quick-input-list-badges');
+	for (const badgeText of item.badges) {
+		const badge = dom.append(badges, $('.quick-input-list-badge'));
+		badge.textContent = badgeText;
+	}
+	data.entry.insertBefore(badges, data.toolBar.getElement());
+	data.badges = badges;
+}
+
+function renderQuickPickMeters(item: IQuickPickItem, data: IQuickInputItemTemplateData): void {
+	if (!item.meters?.length) {
+		return;
+	}
+
+	const meters = $('.quick-input-list-meters');
+	for (const meter of item.meters.slice(0, 2)) {
+		const meterElement = dom.append(meters, $('.quick-input-list-meter'));
+		const meterHeader = dom.append(meterElement, $('.quick-input-list-meter-header'));
+		const label = dom.append(meterHeader, $('.quick-input-list-meter-label'));
+		label.textContent = meter.label;
+		if (meter.description) {
+			const description = dom.append(meterHeader, $('.quick-input-list-meter-description'));
+			description.textContent = meter.description;
+		}
+
+		const value = clampMeterValue(meter.value);
+		const track = dom.append(meterElement, $('.quick-input-list-meter-track'));
+		track.setAttribute('role', 'meter');
+		track.setAttribute('aria-valuemin', '0');
+		track.setAttribute('aria-valuemax', '100');
+		track.setAttribute('aria-valuenow', String(value));
+		track.setAttribute('aria-label', meter.description ? `${meter.label}, ${meter.description}` : meter.label);
+		const fill = dom.append(track, $('.quick-input-list-meter-fill'));
+		fill.classList.add(`quick-input-list-meter-fill-${meter.severity ?? 'normal'}`);
+		fill.style.width = `${value}%`;
+	}
+	data.detail.element.style.display = 'none';
+	data.detailContainer.append(meters);
+	data.meters = meters;
+}
